# Android fstab file.
#<src>                                                  <mnt_point>  <type>  <mnt_flags and options>  <fs_mgr_flags>
/dev/block/platform/13500000.dwmmc0/by-name/SYSTEM      /system      ext4    defaults                 wait,recoveryonly
/dev/block/platform/13500000.dwmmc0/by-name/VENDOR      /vendor      ext4    defaults                 wait,recoveryonly
/dev/block/platform/13500000.dwmmc0/by-name/ODM         /odm         ext4    defaults                 wait,recoveryonly
/dev/block/platform/13500000.dwmmc0/by-name/CACHE       /cache       ext4    noatime,nosuid,nodev     wait,check,formattable,recoveryonly
/dev/block/platform/13500000.dwmmc0/by-name/USERDATA    /data        ext4    noatime,nosuid,nodev     wait,check,formattable,encryptable=footer,length=-20480,quota
/dev/block/platform/13500000.dwmmc0/by-name/EFS         /efs         ext4    noatime,nosuid,nodev     wait,check,recoveryonly
/dev/block/platform/13500000.dwmmc0/by-name/HIDDEN      /preload     ext4    noatime,nosuid,nodev     wait,recoveryonly
/dev/block/platform/13500000.dwmmc0/by-name/BOOT        /boot        emmc    defaults                 recoveryonly
/dev/block/platform/13500000.dwmmc0/by-name/RECOVERY    /recovery    emmc    defaults                 recoveryonly
/dev/block/platform/13500000.dwmmc0/by-name/RADIO       /modem       emmc    defaults                 recoveryonly
/dev/block/platform/13500000.dwmmc0/by-name/MISC        /misc        emmc    defaults                 defaults
